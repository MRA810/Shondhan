DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=shondhan
DB_USER=shondhan
DB_PASSWORD=shondhan_pass
DB_HOST=localhost
DB_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Photos of missing and found people are kept here, outside any public folder.
PRIVATE_MEDIA_ROOT=private_media

# SMS codes for signup and "forgot password".
# console = the code is printed in the Django log (development). For real SMS use bulksmsbd or smsnetbd.
SMS_BACKEND=console
SMS_API_KEY=
SMS_SENDER_ID=

# ---- Production (./build.sh then ./start_production.sh) ----
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=<run: python3 -c "import secrets; print(secrets.token_urlsafe(50))">
# DJANGO_ALLOWED_HOSTS=shondhan.example.com,localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://shondhan.example.com
# DJANGO_HTTPS=1           # 0 only to try the production build on http://localhost
# OTP_DEMO_MODE=0          # 1 = show SMS codes on screen (demo without an SMS provider, never for real users)
